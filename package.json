{
  "name": "volleycoach",
  "private": true,
  "version": "0.1.0",
  "description": "A single-page web app for volleyball tactics and drills.",
  "type": "module",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:prod": "echo 'Running Vite against the PRODUCTION database (Ctrl-C to abort)' && vite",
    "dev:migrate": "bash scripts/dev-migrate.sh",
    "dev:stop": "f(){ if [ -n \"$1\" ]; then lsof -ti tcp:\"$1\" | xargs -r kill; else pkill -f 'node.*\\.bin/vite' || true; fi; }; f",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "db:reset": "bash scripts/db-reset.sh",
    "db:clean": "bash scripts/db-clean.sh",
    "format": "prettier --write \"{src,tests}/**/*.{ts,tsx,json,css}\"",
    "format:check": "prettier --check \"{src,tests}/**/*.{ts,tsx,json,css}\"",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:rls": "bash scripts/test-rls.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@supabase/supabase-js": "^2.107.0",
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@stylistic/eslint-plugin": "^5.5.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.0.10",
    "@vitest/ui": "^4.0.10",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "happy-dom": "^20.0.10",
    "prettier": "^3.6.2",
    "supabase": "^2.105.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.11",
    "vitest": "^4.0.10"
  },
  "prettier": {
    "printWidth": 120,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "es5",
    "tabWidth": 2
  }
}
