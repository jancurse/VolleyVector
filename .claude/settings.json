{
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run test*)",
      "Bash(npm run lint*)",
      "Bash(npm run format*)",
      "Bash(npm run typecheck)",
      "mcp__ide__getDiagnostics",
      "mcp__claude_ai_Context7__resolve-library-id",
      "mcp__claude_ai_Context7__query-docs",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "Bash(npx supabase link:*)",
      "Bash(supabase link:*)",
      "Bash(npx supabase projects list:*)",
      "Bash(supabase projects list:*)",
      "Bash(npx supabase migration list:*)",
      "Bash(supabase migration list:*)",
      "Bash(npx supabase migration new:*)",
      "Bash(supabase migration new:*)",
      "Bash(npx supabase db dump:*)",
      "Bash(supabase db dump:*)",
      "Bash(npx supabase db diff:*)",
      "Bash(supabase db diff:*)",
      "Bash(npx supabase status:*)",
      "Bash(supabase status:*)",
      "Bash(npx supabase gen:*)",
      "Bash(supabase gen:*)",
      "Bash(npx supabase functions list:*)",
      "Bash(supabase functions list:*)",
      "Bash(npx supabase secrets list:*)",
      "Bash(supabase secrets list:*)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push:*)",
      "Bash(gh pr create)",
      "Bash(gh pr create:*)",
      "Bash(npx supabase db push:*)",
      "Bash(supabase db push:*)",
      "Bash(npx supabase db reset:*)",
      "Bash(supabase db reset:*)",
      "Bash(npx supabase db pull:*)",
      "Bash(supabase db pull:*)",
      "Bash(npx supabase migration up:*)",
      "Bash(supabase migration up:*)",
      "Bash(npx supabase migration repair:*)",
      "Bash(supabase migration repair:*)",
      "Bash(npx supabase functions deploy:*)",
      "Bash(supabase functions deploy:*)",
      "Bash(npx supabase secrets set:*)",
      "Bash(supabase secrets set:*)",
      "Bash(npx supabase secrets unset:*)",
      "Bash(supabase secrets unset:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/block-diagnostics-tools.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-markdown.sh\""
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/worktree-create.sh\"",
            "timeout": 60
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/worktree-remove.sh\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  }
}
